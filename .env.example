# Runtime
APP_ENV=development
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_HOURS=8
MAX_CONTENT_LENGTH_MB=10
LOG_LEVEL=INFO

# Database: SQLite is the safe local default.
DATABASE_URL=sqlite:///instance/helpdesk.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/helpdesk

# Local demo identities. Disable in production and provision real accounts separately.
ENABLE_DEMO_AUTH=true
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=change-me-local
DEMO_USER_USERNAME=demo_user
DEMO_USER_PASSWORD=change-me-local

# Encrypts credential-like fields. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Browser / Socket.IO origins
SOCKETIO_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
SOCKETIO_ASYNC_MODE=threading

# Optional Ollama integration
OLLAMA_ENABLED=false
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_THREADS=4
KNOWLEDGE_BASE_PATH=docs/knowledge_base.example.md

# Optional Redis cache for the standalone RAG helper
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional GIF search. Without this key, the UI uses a small curated fallback.
GIPHY_API_KEY=
